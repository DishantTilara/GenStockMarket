# Application Configuration
APP_ENV=development
APP_NAME="Indian Stock Market GenAI Platform"
DEBUG=true
API_V1_STR=/api/v1
SECRET_KEY=change-this-ultra-secure-secret-key-in-production-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=5173
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# Database (PostgreSQL / TimescaleDB)
# For local standalone without PostgreSQL, set fallback to sqlite+aiosqlite:///./stockmarket.db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/stockmarket
SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/stockmarket
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# Redis Cache & PubSub
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=true

# Market Data Provider (simulated, nse, zerodha, angelone, upstox)
MARKET_DATA_PROVIDER=simulated
MARKET_DATA_API_KEY=
MARKET_DATA_API_SECRET=
MARKET_INGESTION_INTERVAL_SECONDS=1
AUTO_SEED_INSTRUMENTS=true

# AI Provider (openai, local, anthropic, gemini)
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LOCAL_LLM_URL=http://localhost:11434/v1

# News Provider (simulated, newsapi, moneycontrol)
NEWS_PROVIDER=simulated
NEWS_API_KEY=

# Broker Provider (paper, zerodha, upstox)
BROKER_PROVIDER=paper
BROKER_API_KEY=
BROKER_API_SECRET=

# Risk Management
MAX_ORDER_VALUE_INR=500000.00
MAX_PORTFOLIO_EXPOSURE_PCT=0.25
MAX_DAILY_LOSS_PCT=0.05
REQUIRE_EXPLICIT_TRADE_CONFIRMATION=true
